# Use a reachable local or production backend address ending in /api.
# Stop and rerun the app after changing this value.
# Example LAN URL: http://192.168.1.10:3002/api (configure server LAN binding).
# Use HTTPS in production. Never put credentials or a default workspace here.
API_BASE_URL=

# App Store storefront used to look up the published iOS version (e.g. eg).
APP_STORE_COUNTRY=us
